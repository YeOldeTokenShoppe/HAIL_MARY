          "cues": []
        },
        {
          "n": 10,
          "actor": "Barron",
          "voiceId": "IcFWazAaBzXNwLWpySgF",
          "text": "[suspiciously] You are doing the thing where you make redemptions sound like a spiritual exercise.",
