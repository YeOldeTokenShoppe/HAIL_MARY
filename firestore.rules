 rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      // Pump customization configs — keyed by {userId}_{col}_{row}
      match /pumpConfigs/{docId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['userId', 'col', 'row', 'config', 'updatedAt'])
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0;
        allow update: if true
          && request.resource.data.userId == resource.data.userId;
        allow delete: if false;
      }

      // Public read access to market data
      match /marketData/{document} {
        allow read: if true;
        allow write: if false;
      }

      // Optional: Restrict historical data
      match /marketHistory/{document} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Allow public read/write to candles collection (NEW)
      match /candles/{document} {
        allow read: if true;
        allow write: if true;
        // For production, you might want to add:
        // allow write: if request.resource.data.username != null
        //   && request.resource.data.message != null
        //   && request.resource.data.message.size() <= 500;
      }

      // Allow public read/write to results collection (legacy candles)
      match /results/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Allow public read/write to fountain_coins collection
      match /fountain_coins/{document} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['position', 'rotation',
  'timestamp'])
          && request.resource.data.position.keys().hasAll(['x', 'y', 'z'])
          && request.resource.data.rotation.keys().hasAll(['x', 'y', 'z']);
        allow update: if false;
        allow delete: if true;
      }

      // Allow read and write access to fountain archives
      match /fountain_archives/{document} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if false;
      }

      // Stakes collection - for tracking staking transactions
      match /stakes/{document} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['amount', 'walletAddress', 'timestamp'])
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;
        allow update: if false;
        allow delete: if false;
      }

      // =========================================================================
      // PREDICTION MARKETS
      // =========================================================================

      // Prediction Markets - public read, server-only write
      match /predictionMarkets/{marketId} {
        allow read: if true;
        allow write: if false; // Only Railway service account writes
      }

      // Prediction Bets - users can create with their userId, read their own
      match /predictionBets/{betId} {
        allow read: if true; // Allow public read for leaderboards
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['marketId', 'optionId', 'amount', 'userId'])
          && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      // Prediction Payouts - public read, server-only write
      match /predictionPayouts/{payoutId} {
        allow read: if true;
        allow write: if false; // Only Railway service resolves
      }

      // =========================================================================
      // ORACLE ACCURACY TRACKING
      // =========================================================================

      // Oracle Accuracy Logs - public read, server-only write
      match /oracleAccuracyLogs/{logId} {
        allow read: if true;
        allow write: if false; // Only Railway service writes
      }

      // Oracle Accuracy Stats - public read, server-only write
      match /oracleAccuracyStats/{statsId} {
        allow read: if true;
        allow write: if false; // Only Railway service writes
      }

      // =========================================================================
      // CAROUSEL CHAT SYSTEM
      // =========================================================================

      // Carousel Beasts - riders on the carousel
      match /carouselBeasts/{beastId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'username', 'imageUrl', 'timestamp'])
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 50
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 500;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Carousel Chat - messages from riders
      match /carouselChat/{messageId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['beastId', 'message', 'userId', 'username', 'timestamp'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 80
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 50;
      }

      // Global Chat - spectator lounge
      match /globalChat/{messageId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['message', 'userId', 'username', 'timestamp'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 200
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 50;
        allow update, delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Carousel Waitlist
      match /carouselWaitlist/{docId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Chat Reports - users can create reports, only admins can read/update
      match /chatReports/{reportId} {
        allow read: if false; // Only admin via Firebase console or Cloud Functions
        allow create: if request.auth != null
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'messageContent', 'chatType', 'timestamp', 'status'])
          && request.resource.data.messageContent is string
          && request.resource.data.messageContent.size() <= 200;
        allow update, delete: if false; // Only admin
      }

      // =========================================================================
      // CANDLE SHRINE OFFERINGS
      // =========================================================================

      // Offerings - candles lit by users
      match /offerings/{offeringId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['name', 'type', 'userId', 'createdAt', 'litAt', 'position']);
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Temple Candles - candles lit in the 3D temple scene (trade page)
      match /templeCandles/{candleId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['candleIndex', 'userId', 'username', 'message', 'type', 'tokensBurned', 'walletAddress', 'litAt']);
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // User Stats - leaderboard tracking
      match /userStats/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == userId;
        allow delete: if false;
      }

      // Users collection
      match /users/{userId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == userId;
      }

      // =========================================================================
      // WEEKLY PRIZES / GACHAPON
      // =========================================================================

      // Weekly Prizes - public read, allow claimCount increment
      match /weeklyPrizes/{prizeId} {
        allow read: if true;
        allow update: if true;
      }

      // Prize Claims - public read, allow creating claims
      match /prizeClaims/{claimId} {
        allow read, create: if true;
      }

      // X OAuth tokens - server writes, no client access
      match /config/{document} {
        allow read: if false;
        allow write: if true;
      }

      // Followers data - public read, server write
      match /followers/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Tweets data - public read, server write
      match /tweets/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Oil Drill progress — one doc per user tracking daily drill state
      match /oilDrills/{docId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['userId', 'col', 'row', 'drillDay', 'lastDrillDate', 'updatedAt'])
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0;
        allow update: if true
          && request.resource.data.userId == resource.data.userId;
        allow delete: if false;
      }

      // Oil Game settings — public read, admin-only write (password-gated in UI)
      match /oilGame/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Rogue events — public read (onSnapshot for all clients), server writes (password-gated API)
      match /rogueEvents/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // CCTV recordings — camera owner can read their own, anyone can create
      match /cctvRecordings/{docId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['userId', 'eventType', 'col', 'row', 'downloadUrl', 'storagePath', 'durationMs', 'createdAt']);
        allow update, delete: if false;
      }

      // Gusher events — broadcast oil strikes to all players
      match /gusherEvents/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // Telegram linking — server writes via webhook, read by API route
      match /oilTelegram/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // Default rules - SECURE by default
      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }
  }