 rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      // Pump customization configs — keyed by {userId}_{col}_{row}
      match /pumpConfigs/{docId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['userId', 'col', 'row', 'config', 'updatedAt'])
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0;
        allow update: if true
          && request.resource.data.userId == resource.data.userId;
        allow delete: if false;
      }

      // Public read access to market data
      match /marketData/{document} {
        allow read: if true;
        allow write: if false;
      }

      // Optional: Restrict historical data
      match /marketHistory/{document} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Allow public read/write to candles collection (NEW)
      match /candles/{document} {
        allow read: if true;
        allow write: if true;
        // For production, you might want to add:
        // allow write: if request.resource.data.username != null
        //   && request.resource.data.message != null
        //   && request.resource.data.message.size() <= 500;
      }

      // Allow public read/write to results collection (legacy candles)
      match /results/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Allow public read/write to fountain_coins collection
      match /fountain_coins/{document} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['position', 'rotation',
  'timestamp'])
          && request.resource.data.position.keys().hasAll(['x', 'y', 'z'])
          && request.resource.data.rotation.keys().hasAll(['x', 'y', 'z']);
        allow update: if false;
        allow delete: if true;
      }

      // Allow read and write access to fountain archives
      match /fountain_archives/{document} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if false;
      }

      // Stakes collection - for tracking staking transactions
      match /stakes/{document} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['amount', 'walletAddress', 'timestamp'])
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;
        allow update: if false;
        allow delete: if false;
      }

      // =========================================================================
      // PREDICTION MARKETS
      // =========================================================================

      // Prediction Markets - public read, server-only write
      match /predictionMarkets/{marketId} {
        allow read: if true;
        allow write: if false; // Only Railway service account writes
      }

      // Prediction Bets - users can create with their userId, read their own
      match /predictionBets/{betId} {
        allow read: if true; // Allow public read for leaderboards
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['marketId', 'optionId', 'amount', 'userId'])
          && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      // Prediction Payouts - public read, server-only write
      match /predictionPayouts/{payoutId} {
        allow read: if true;
        allow write: if false; // Only Railway service resolves
      }

      // =========================================================================
      // ORACLE ACCURACY TRACKING
      // =========================================================================

      // Oracle Accuracy Logs - public read, server-only write
      match /oracleAccuracyLogs/{logId} {
        allow read: if true;
        allow write: if false; // Only Railway service writes
      }

      // Oracle Accuracy Stats - public read, server-only write
      match /oracleAccuracyStats/{statsId} {
        allow read: if true;
        allow write: if false; // Only Railway service writes
      }

      // =========================================================================
      // CAROUSEL CHAT SYSTEM
      // =========================================================================

      // Carousel Beasts - riders on the carousel
      match /carouselBeasts/{beastId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'username', 'imageUrl', 'timestamp'])
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 50
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 500;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Carousel Chat - messages from riders
      match /carouselChat/{messageId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['beastId', 'message', 'userId', 'username', 'timestamp'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 80
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 50;
      }

      // Global Chat - spectator lounge
      match /globalChat/{messageId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['message', 'userId', 'username', 'timestamp'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 1
          && request.resource.data.message.size() <= 200
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 50;
        allow update, delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Carousel Waitlist
      match /carouselWaitlist/{docId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Chat Reports - users can create reports, only admins can read/update
      match /chatReports/{reportId} {
        allow read: if false; // Only admin via Firebase console or Cloud Functions
        allow create: if request.auth != null
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'messageContent', 'chatType', 'timestamp', 'status'])
          && request.resource.data.messageContent is string
          && request.resource.data.messageContent.size() <= 200;
        allow update, delete: if false; // Only admin
      }

      // =========================================================================
      // CANDLE SHRINE OFFERINGS
      // =========================================================================

      // Offerings - candles lit by users
      match /offerings/{offeringId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['name', 'type', 'userId', 'createdAt', 'litAt', 'position']);
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Temple Candles - candles lit in the 3D temple scene (trade page)
      match /templeCandles/{candleId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['candleIndex', 'userId', 'username', 'message', 'type', 'tokensBurned', 'walletAddress', 'litAt']);
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // User Stats - leaderboard tracking
      match /userStats/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == userId;
        allow delete: if false;
      }

      // Users collection
      match /users/{userId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid == userId;
      }

      // =========================================================================
      // WEEKLY PRIZES / GACHAPON
      // =========================================================================

      // Weekly Prizes - public read, allow claimCount increment
      match /weeklyPrizes/{prizeId} {
        allow read: if true;
        allow update: if true;
      }

      // Prize Claims - public read, allow creating claims
      match /prizeClaims/{claimId} {
        allow read, create: if true;
      }

      // X OAuth tokens — server-only (Admin SDK). No client read OR write:
      // write:true previously let anyone overwrite config/x_oauth and hijack the
      // account's tokens. All writers (auth/x/callback, cron) use the Admin SDK.
      match /config/{document} {
        allow read: if false;
        allow write: if false;
      }

      // Followers data - public read, server write
      match /followers/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Tweets data - public read, server write
      match /tweets/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Oil Drill progress — one doc per user tracking daily drill state.
      // Public read; ALL writes go through server endpoints (oil-claim,
      // oil-claim-jump, oil-release, oil-transfer, oil-profile, oil-tank-drain,
      // oil-strike-tick, oil-demon-bounty) via the Admin SDK, which bypasses
      // these rules. Prize money rides on tankOil/totalCollected — no client
      // write path is permitted.
      match /oilDrills/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Oil Game settings — public read, server-only write via Admin SDK.
      // All writes go through /api/oil-settings, /api/oil-tank-drain,
      // /api/oil-ticket, /api/oil-draft-skip, /api/oil-qualify, which use
      // firebaseAdmin (getAdminDb) and bypass these rules. Prize money is
      // on the line — no client SDK write path is permitted.
      match /oilGame/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Distribution seed (commit-reveal). The raw seed decides where the oil
      // is — exposing it would let any player compute the whole field. It is
      // server-only: written/read exclusively via the admin SDK. The public
      // commitment + post-game reveal live on oilGame/settings instead.
      match /oilSecret/{docId} {
        allow read: if false;
        allow write: if false;
      }

      // Rogue events — public read (onSnapshot for all clients), server writes (password-gated API)
      match /rogueEvents/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // CCTV recordings — camera owner can read their own, anyone can create
      match /cctvRecordings/{docId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['userId', 'eventType', 'col', 'row', 'downloadUrl', 'storagePath', 'durationMs', 'createdAt']);
        allow update, delete: if false;
      }

      // Gusher events — broadcast oil strikes to all players
      match /gusherEvents/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // Claim/jump audit log — public read so anyone can audit plot placement
      // against the revealed map post-game (insider-tipping accountability).
      // Server-only writes (via /api/oil-claim + /api/oil-claim-jump).
      match /oilClaimLog/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // FIELD ACTIVITY timeline — public who/what/when feed (no amounts/coords).
      // Server-only writes via the strike-tick / claim / demon routes.
      match /oilTimeline/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Oil Qualified players — registration + qualification for the oil game.
      // Public read; writes are server-only. `qualified` is decided by an
      // on-chain RL80 balance re-check in /api/oil-register and the admin
      // snapshot — the client must never be able to self-qualify.
      match /oilQualified/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Oil Plot messaging — per-plot chat between players. Public read so any
      // client can render a thread, but ALL writes are server-only via
      // /api/oil-message: the route derives the sender from the verified Clerk
      // session (no identity spoofing), enforces the conversation thread, and
      // limits deletes to the message author or the plot owner. A client SDK
      // create/delete here would let anyone post as anyone or wipe the board.
      match /oilPlotMessages/{msgId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      // Oil Plots — claimed plots on the grid, and the server-written reveal
      // (drilled depth, revealed oil per layer, hell layers). Public read so
      // clients can render the field; writes are server-only. Letting a client
      // write here would let it forge ownership or fabricate oil — locked.
      match /oilPlots/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Telegram linking — server writes via webhook, read by API route
      match /oilTelegram/{docId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // =========================================================================
      // RACE LEADERBOARD
      // =========================================================================

      // Race times — public read, public create (anonymous players allowed)
      match /race_times/{docId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['time', 'position', 'track', 'userId', 'userName', 'createdAt'])
          && request.resource.data.time is number
          && request.resource.data.time > 0
          && request.resource.data.position is int
          && request.resource.data.position >= 1;
        allow update, delete: if false;
      }

      // =========================================================================
      // HOME PAGE SHRINE CANDLES — one lit candle per user (doc ID = Clerk userId)
      // =========================================================================
      match /shrineCandles/{userId} {
        // These docs feed the landing-page VigilTicker, so every
        // writable display field is tightly shaped: displayName must
        // look like the app's shortened wallet address (0x1234…abcd)
        // and every intention must be one of the preset keys from
        // src/lib/intentions.js — keep that list and this one in sync.
        // Without this, a raw client-SDK write could scroll arbitrary
        // text (scam links, slurs) across the homepage chyron.
        // A candle can carry several intentions ("all that apply"), so
        // `intention` is normally an array; the bare-string form is
        // still accepted for legacy docs and stale clients mid-deploy.
        function validTickerFields(data) {
          return (!('displayName' in data)
              || data.displayName == null
              || (data.displayName is string
                  && data.displayName.matches('0x[0-9a-fA-F]{4}…[0-9a-fA-F]{4}')))
            && (!('intention' in data)
              || data.intention == null
              || data.intention in ['prosper80', 'secur80', 'human80',
                  'liquid80', 'opportun80', 'char80', 'π80', 'etern80']
              || (data.intention is list
                  && data.intention.size() <= 8
                  && data.intention.hasOnly(['prosper80', 'secur80',
                      'human80', 'liquid80', 'opportun80', 'char80',
                      'π80', 'etern80'])));
        }
        // Burn credit (tokensBurned & friends) is written ONLY by
        // /api/burn-offering via the admin SDK after verifying a real
        // on-chain RL80 transfer to the dead address. Clients may never
        // SET or ALTER these fields — but a re-light's full setDoc may
        // REMOVE them (each fresh candle starts unburned), and merge
        // writes that leave them unchanged must keep working. Note
        // request.resource.data is the post-write doc, so equality
        // against resource.data is the right "untouched" test.
        function burnFieldsNotSet(data) {
          return !('tokensBurned' in data)
            && !('lastBurnTxHash' in data)
            && !('lastBurnAt' in data);
        }
        function burnFieldsNotForged() {
          return (!('tokensBurned' in request.resource.data)
              || request.resource.data.tokensBurned == resource.data.get('tokensBurned', null))
            && (!('lastBurnTxHash' in request.resource.data)
              || request.resource.data.lastBurnTxHash == resource.data.get('lastBurnTxHash', null))
            && (!('lastBurnAt' in request.resource.data)
              || request.resource.data.lastBurnAt == resource.data.get('lastBurnAt', null));
        }
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['userId', 'litAt'])
          && request.resource.data.userId is string
          && request.resource.data.userId == userId
          && validTickerFields(request.resource.data)
          && burnFieldsNotSet(request.resource.data);
        allow update: if true
          && request.resource.data.userId == resource.data.userId
          && validTickerFields(request.resource.data)
          && burnFieldsNotForged();
        allow delete: if true;
      }

      // =========================================================================
      // SHRINE BURNS — one doc per credited burn tx (doc ID = tx hash).
      // Public provenance ledger for votive burn offerings; written only
      // by /api/burn-offering (admin SDK) after on-chain verification.
      // =========================================================================
      match /shrineBurns/{txHash} {
        allow read: if true;
        allow write: if false;
      }

      // =========================================================================
      // SHRINE CANDLE PREFS — cosmetic customization (variant, votive image
      // data URL, wax tint) that persists independently of lit/unlit state
      // so prefs cross devices and outlive extinguish. Doc ID = Clerk userId.
      // Follows the shrineCandles pattern: open reads, body's userId must
      // match the doc id. Server-side enforcement of image size happens
      // in lib/candleRitual.js via PREFS_IMAGE_MAX_BYTES.
      // =========================================================================
      match /shrineCandlePrefs/{userId} {
        allow read: if true;
        allow create: if true
          && request.resource.data.userId is string
          && request.resource.data.userId == userId;
        allow update: if true
          && request.resource.data.userId == resource.data.userId;
        allow delete: if true;
      }

      // =========================================================================
      // SHRINE TESTIMONIALS — short "witness" posts rotated as toasts on /home.
      // All writes go through /api/testimonials (Clerk auth + OpenAI
      // moderation + rate limits) using firebase-admin, which bypasses
      // these rules. Reads stay open for the realtime subscription.
      // =========================================================================
      match /shrineTestimonials/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Rate-limit counters written by /api/testimonials via admin SDK.
      match /testimonialRateLimits/{userId} {
        allow read, write: if false;
      }

      // =========================================================================
      // PUBLIC-READ COLLECTIONS (no other writers — written by admin/server SDK,
      // which bypasses rules). These previously relied on the permissive
      // catch-all for read. They are listed explicitly because the catch-all is
      // now deny-by-default (see below) — Firestore rules are ADDITIVE (OR), so
      // a broad `read: if true` catch-all silently overrode every `read: if
      // false` (it was leaking config/x_oauth OAuth tokens, oilSecret seed,
      // chatReports, testimonialRateLimits). Reads here are unchanged; the only
      // behavioral change is that the deny-by-default now actually enforces the
      // read:false collections.
      // =========================================================================
      match /demonBounty/{d}      { allow read: if true; allow write: if false; }
      match /oilPurchases/{d}     { allow read: if true; allow write: if false; }
      match /polaroids/{d}        { allow read: if true; allow write: if false; }
      // Auto-capture news/social feed (gusher + hell milestones). Public read is
      // gated on `approved` so unmoderated rig art (custom sign images) stays
      // hidden until reviewed. Written only by the admin SDK (/api/upload-polaroid).
      match /oilFeed/{d}          { allow read: if resource.data.approved == true; allow write: if false; }
      match /fountain_donations/{d} { allow read: if true; allow write: if false; }
      match /trades/{d}           { allow read: if true; allow write: if false; }
      match /decisions/{d}        { allow read: if true; allow write: if false; }
      match /summaries/{d}        { allow read: if true; allow write: if false; }
      match /market/{d}           { allow read: if true; allow write: if false; }
      match /macroData/{d}        { allow read: if true; allow write: if false; }
      match /newsData/{d}         { allow read: if true; allow write: if false; }
      match /technicalData/{d}    { allow read: if true; allow write: if false; }
      match /sentimentData/{d}    { allow read: if true; allow write: if false; }
      match /sentiment_analysis/{d}         { allow read: if true; allow write: if false; }
      match /sentiment_analysis_history/{d} { allow read: if true; allow write: if false; }
      match /lighterData/{d}      { allow read: if true; allow write: if false; }
      match /simulatedAccount/{d}      { allow read: if true; allow write: if false; }
      match /simulatedPositions/{d}    { allow read: if true; allow write: if false; }
      match /simulatedTradeHistory/{d} { allow read: if true; allow write: if false; }
      match /agentChat/{d}        { allow read: if true; allow write: if false; }
      match /agentContext/{d}     { allow read: if true; allow write: if false; }
      match /agentDecisions/{d}   { allow read: if true; allow write: if false; }
      match /agentScores/{d}      { allow read: if true; allow write: if false; }
      match /systemConfig/{d}     { allow read: if true; allow write: if false; }
      match /weeklyAnalysis/{d}   { allow read: if true; allow write: if false; }
      match /xPost/{d}            { allow read: if true; allow write: if false; }
      match /test/{d}             { allow read: if true; allow write: if false; }

      // Default rules — DENY by default. Firestore ORs all matching rules, so a
      // permissive catch-all here would override every explicit `read: if false`
      // above. Anything not explicitly granted read access is private.
      match /{document=**} {
        allow read: if false;
        allow write: if false;
      }
    }
  }