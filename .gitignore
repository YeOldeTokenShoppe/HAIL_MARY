# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase config files with keys
**/firebase-config.js
**/moonroom-config.js

# API keys and secrets
**/api-keys/*

# Firebase service account keys
serviceAccountKey.json
firebase-service-account.json
firebase-adminsdk*.json

# clerk configuration (can include secrets)
/.clerk/




cache/*

# Foundry (oil payout contract)
contracts/out/
contracts/cache/
contracts/lib/

# Raw screen-recording masters — ship the compressed .mp4 instead
public/videos/*.mov
content/lt-tv/audio/
# The staging area: briefs and episode records are regenerated on every run,
# and the slate under src/content/lt-tv/episodes/ is the committed copy.
content/lt-tv/episodes/*.json
content/lt-tv/episodes/*.txt
content/lt-tv/briefs/
content/lt-tv/plans/
content/lt-tv/status.html
# The old pipeline writes its masters and its starter record here (see
# docs/talk-show-production.md). Same rule as content/lt-tv/audio/ above:
# recorded audio is regenerated, it lives in SitePal once uploaded, and a
# 5MB WAV per character per run does not belong in the repo.
elevenlabs-dialogue-test/output/

# Python bytecode, regenerated on every run
__pycache__/
*.pyc
