### HAIL MARY Debate Agents — Saint GR80 vs H80Z ###
### Required Environment Variables for Railway Deployment ###

# ===========================================
# MODEL PROVIDERS (required)
# ===========================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===========================================
# TELEGRAM BOTS (required — one token per agent)
# ===========================================

SAINT_GR80_TELEGRAM_BOT_TOKEN=
H80Z_TELEGRAM_BOT_TOKEN=

# ===========================================
# TWITTER / X API (Saint GR80 — Our Lady of Perpetual Profit)
# ===========================================

SAINT_GR80_TWITTER_API_KEY=
SAINT_GR80_TWITTER_API_SECRET_KEY=
SAINT_GR80_TWITTER_ACCESS_TOKEN=
SAINT_GR80_TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_ENABLE_POST=true
TWITTER_DRY_RUN=true

# ===========================================
# DEBATE SCHEDULING (optional)
# ===========================================

# Active hours — debates only run during this window
# Bots still respond to @mentions outside these hours
DEBATE_ACTIVE_START=9
DEBATE_ACTIVE_END=23
DEBATE_TIMEZONE=America/Los_Angeles

# ===========================================
# LOGGING (optional)
# ===========================================

LOG_LEVEL=info
SENTRY_LOGGING=false
