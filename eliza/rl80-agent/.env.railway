# RL80 Railway Environment Variables
# Copy these to your Railway service variables

# ===========================================
# REQUIRED: Model Provider (at least one)
# ===========================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===========================================
# REQUIRED: Firebase Admin SDK
# ===========================================
FIREBASE_PROJECT_ID=hailmary-3ff6c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-k140q@hailmary-3ff6c.iam.gserviceaccount.com

# For Railway, use Base64 encoded private key (avoids newline issues)
# Encode with: cat key.json | jq -r '.private_key' | base64
FIREBASE_PRIVATE_KEY_BASE64=

# OR use the raw private key (must handle newlines correctly)
# FIREBASE_PRIVATE_KEY=

# ===========================================
# OPTIONAL: Communication Channels
# ===========================================
# DISCORD_API_TOKEN=
# TELEGRAM_BOT_TOKEN=

# ===========================================
# OPTIONAL: Database (defaults to PGLite)
# ===========================================
# For persistent memory across restarts, use Railway's Postgres
# POSTGRES_URL=postgresql://user:pass@host:5432/db

# ===========================================
# SYSTEM
# ===========================================
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
SERVER_PORT=3000
