rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read audio files
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Allow anyone to read video files
    match /video/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
