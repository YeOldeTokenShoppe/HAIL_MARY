rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read audio files
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Allow anyone to read video files
    match /video/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Sign images — scoped by userId folder. Capped + image-only so a bad/modified
    // client can't drop an oversized texture into the shared scene. Client resizes
    // to <=512px WebP (~20-40KB) before upload; 1MB is generous headroom.
    match /signImages/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // CCTV recordings — public read, write limited to webm under 10MB
    match /cctv/{fileName} {
      allow read: if true;
      allow write: if resource == null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Polaroid snapshots — public read, write limited to images under 5MB
    match /polaroids/{fileName} {
      allow read: if true;
      allow write: if resource == null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
