  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      // Public read access to market data (writes allowed for trading system)
      match /marketData/{document} {
        allow read: if true;
        allow write: if true; // Allow trading system to write market data
      }

      // Restrict historical data to authenticated users
      match /marketHistory/{document} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Allow public read/write to candles collection (legacy)
      match /candles/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Allow public read/write to results collection (legacy candles)
      match /results/{document} {
        allow read: if true;
        allow write: if true;
      }

      // Offerings collection (candle lighting with token burn)
      match /offerings/{document} {
        // Allow anyone to read offerings (for displaying candles/shrine)
        allow read: if true;

        // Allow creating new offerings with required fields
        // Temporarily relaxed auth requirement while debugging
        allow create: if request.resource.data.keys().hasAll(['walletAddress', 'userId', 'tokensBurned',
  'message', 'name', 'type', 'createdAt'])
          && request.resource.data.walletAddress is string
          && request.resource.data.userId is string
          && request.resource.data.tokensBurned is number
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 1000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.type in ['petition', 'appreciation', 'confession', 'gratitude', 'blessing', 'memorial'];

        // Allow updating offerings (for adding polaroidUrl, etc.)
        allow update: if request.resource.data.walletAddress == resource.data.walletAddress
          && request.resource.data.tokensBurned == resource.data.tokensBurned
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt;

        // Allow deleting offerings (for replacement functionality)
        allow delete: if true;
      }

      // Allow public read/write to fountain_coins collection
      match /fountain_coins/{document} {
        allow read: if true;
        allow create: if true
          && request.resource.data.keys().hasAll(['position', 'rotation', 'timestamp'])
          && request.resource.data.position.keys().hasAll(['x', 'y', 'z'])
          && request.resource.data.rotation.keys().hasAll(['x', 'y', 'z']);
        allow update: if false;
        allow delete: if true;
      }

      // Allow read and write access to fountain archives
      match /fountain_archives/{document} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if false;
      }

      // Allow public read access to sentiment analysis data
      match /sentiment_analysis/{document} {
        allow read: if true;
        allow write: if false; // Only backend services should write sentiment data
      }

      // Trading system collections - allow full access for development
      match /agentChat/{chatId} {
        allow read, write: if true;
      }
      
      match /lighterData/{docId} {
        allow read, write: if true;
      }
      
      match /marketData/{docId} {
        allow read, write: if true;
      }
      
      match /agentContext/{docId} {
        allow read, write: if true;
      }
      
      match /serviceStatus/{docId} {
        allow read, write: if true;
      }
      
      match /trades/{tradeId} {
        allow read, write: if true;
      }

      // Block all other collections by default (secure by default)
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }